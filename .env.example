# Public Firebase WEB configuration from the existing project (not an Admin SDK key).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=syed-ammar
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Public HTTPS Cloudflare proxy URLs. These are embedded in the browser bundle.
VITE_WEBHOOK_PROXY_URL=
# Compatibility alias: use the contact PROXY URL, never a raw Discord webhook.
VITE_DISCORD_WEBHOOK_URL=
VITE_GEMINI_PROXY_URL=
VITE_MEDIA_WORKER_URL=

# Optional: existing Firebase email/password administrator account.
# Without this, the established compatibility account remains in use.
VITE_ADMIN_EMAIL=

# Never put DISCORD_WEBHOOK_URL, GEMINI_API_KEY, an ImageKit private key,
# a Firebase service-account key or a Cloudflare API token in a VITE_ variable.
